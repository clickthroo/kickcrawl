{
  "name": "kickcrawl",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/api",
    "apps/admin"
  ],
  "scripts": {
    "dev:api": "npm run dev -w apps/api",
    "dev:admin": "npm run dev -w apps/admin",
    "build": "npm run build -w apps/api && npm run build -w apps/admin",
    "build:api": "npm run build -w apps/api",
    "build:admin": "npm run build -w apps/admin",
    "start": "npm run start -w apps/api",
    "test": "npm run test -w apps/api",
    "migrate": "npm run migrate -w apps/api"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
