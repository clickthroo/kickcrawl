# Postgres connection string
DATABASE_URL=postgresql://kickcrawl:kickcrawl@localhost:5432/kickcrawl

# Redis connection string (used by BullMQ for background jobs)
REDIS_URL=redis://localhost:6379

# HTTP port the API + admin UI are served on
PORT=3000
APP_URL=http://localhost:3000

# Used only for the /api/v1/extract LLM fallback, when no site selectors match
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional upstream proxy for Playwright/fetch when a site has use_proxy enabled
PROXY_URL=

# Sent as the User-Agent header on plain fetch requests (Playwright rotates a
# realistic browser UA pool separately - see src/services/userAgents.ts)
DEFAULT_USER_AGENT="KickioBot/1.0 (+https://kickio.com/bot)"

# Admin dashboard login (bootstrap admin user)
ADMIN_EMAIL=admin@kickio.com
# Generate with: node -e "require('bcryptjs').hash('yourpassword',10).then(console.log)"
ADMIN_PASSWORD_HASH=

# Session cookie signing secret - set to a long random string in production
SESSION_SECRET=change-me-to-a-long-random-string

# Optional webhook fired on crawl job completion
WEBHOOK_URL=
