{
  "name": "@kickcrawl/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && cp -r src/migrations dist/migrations",
    "start": "node dist/index.js",
    "migrate": "tsx src/lib/migrate.ts",
    "backfill-item-profiles": "tsx src/lib/backfillItemProfiles.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "fastify": "^4.28.1",
    "@fastify/cookie": "^9.4.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/static": "^7.0.4",
    "pg": "^8.13.1",
    "bullmq": "^5.21.2",
    "ioredis": "^5.4.1",
    "cheerio": "^1.0.0",
    "turndown": "^7.2.0",
    "playwright": "1.48.0",
    "bcryptjs": "^2.4.3",
    "uuid": "^9.0.1",
    "dotenv": "^16.4.5",
    "robots-parser": "^3.0.1",
    "fast-xml-parser": "^4.5.0",
    "undici": "^6.19.8",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/pg": "^8.11.10",
    "@types/bcryptjs": "^2.4.6",
    "@types/uuid": "^9.0.8",
    "@types/turndown": "^5.0.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
